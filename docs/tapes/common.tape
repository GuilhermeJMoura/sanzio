Set Shell "zsh"
Set FontFamily "Menlo"
Set FontSize 15
Set Width 1440
Set Height 860
Set Padding 18
Set Margin 0
Set WindowBar ""
Set TypingSpeed 35ms
Set Theme { "name": "verniz", "background": "#1b170f", "foreground": "#ece1c6", "cursor": "#dcab4a", "selection": "#24407a", "black": "#1b170f", "red": "#e8694c", "green": "#b0cd78", "yellow": "#dcab4a", "blue": "#86aaee", "magenta": "#d58bb0", "cyan": "#8fc7c0", "white": "#ece1c6", "brightBlack": "#9d906d", "brightRed": "#f69a84", "brightGreen": "#c6dd96", "brightYellow": "#e3ad66", "brightBlue": "#a9c2f3", "brightMagenta": "#e7a9c8", "brightCyan": "#a9dbd4", "brightWhite": "#fbf3dc" }
Env CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC "1"
